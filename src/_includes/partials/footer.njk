{% from "icons/icon.njk" import icon, brand %}
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        {{ brand(withTagline=false) }}
        <p>
          Fábrica e escritório em Curitiba. Sacolas de papel personalizadas para lojas, eventos e campanhas — entregamos em todo o Brasil.
        </p>
      </div>
      <div>
        <h5>Produtos</h5>
        <ul>
          <li><a href="#catalogo">Sacola PP</a></li>
          <li><a href="#catalogo">Sacola P</a></li>
          <li><a href="#catalogo">Sacola M</a></li>
        </ul>
      </div>
      <div>
        <h5>Empresa</h5>
        <ul>
          <li><a href="#catalogo">Catálogo</a></li>
          <li><a href="#depoimentos">Clientes</a></li>
          <li><a href="#orcamento">Orçamento</a></li>
          <li><a href="#faq">Dúvidas</a></li>
        </ul>
      </div>
      <div>
        <h5>Contato</h5>
        <ul>
          <li><a href="https://wa.me/{{ site.whatsappDigits }}" target="_blank" rel="noopener">{{ icon("whatsapp", 14) }} {{ site.whatsapp }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ icon("mail", 14) }} {{ site.email }}</a></li>
          <li><a href="https://www.instagram.com/uma.sacola/" target="_blank" rel="noopener">{{ icon("instagram", 14) }} {{ site.instagram }}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ site.year }} Uma Sacola</span>
      <span>Transformando sua marca em presença</span>
    </div>
  </div>
</footer>
