{% from "icons/icon.njk" import icon %}
<section class="hero">
  <div class="container hero-grid">
    <div>
      <h1>
        Sacolas que <span class="accent">vendem</span> a sua marca
      </h1>
      <p class="hero-lede">
        Sacolas de papel personalizadas, feitas sob medida para empresas que levam
        a experiência do cliente a sério. Do logo à entrega um fornecedor só.
      </p>
      <div class="hero-cta-row">
        <button class="btn btn-primary" data-open-quote>
          Pedir orçamento grátis {{ icon("arrow-right", 18) }}
        </button>
        <a href="#catalogo" class="btn btn-outline">
          Ver catálogo e preços
        </a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-frame"></div>
      <div class="hero-card">
        <img src="/images/sacola-m-hero-clean.jpeg" alt="Sacola personalizada Tech Cell" />
      </div>
      <div class="hero-chip br">
        <div class="ch-num">10d</div>
        <div class="ch-lbl">prazo médio<br/>entregue</div>
      </div>
    </div>
  </div>
</section>
