{# icon macro: usage {% from "icons/icon.njk" import icon %} {{ icon("arrow-right", 18, 2) }} #}
{%- macro icon(name, size=22, stroke=2) -%}
{%- set common = 'width="' + size + '" height="' + size + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="' + stroke + '" stroke-linecap="round" stroke-linejoin="round"' -%}
{%- if name == "arrow-right" -%}<svg {{ common | safe }}><path d="M5 12h14M13 6l6 6-6 6"/></svg>
{%- elif name == "check" -%}<svg {{ common | safe }}><path d="M5 12l5 5L20 7"/></svg>
{%- elif name == "plus" -%}<svg {{ common | safe }}><path d="M12 5v14M5 12h14"/></svg>
{%- elif name == "close" -%}<svg {{ common | safe }}><path d="M6 6l12 12M18 6L6 18"/></svg>
{%- elif name == "truck" -%}<svg {{ common | safe }}><rect x="1" y="6" width="14" height="10" rx="1"/><path d="M15 9h4l3 3v4h-7"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
{%- elif name == "palette" -%}<svg {{ common | safe }}><path d="M12 22a10 10 0 1 1 0-20 7 7 0 0 1 7 7c0 2.5-2 3-3 3h-2a2 2 0 0 0-1.4 3.4A2 2 0 0 1 12 22z"/><circle cx="7.5" cy="10.5" r="0.5" fill="currentColor"/><circle cx="12" cy="7.5" r="0.5" fill="currentColor"/><circle cx="16.5" cy="10.5" r="0.5" fill="currentColor"/></svg>
{%- elif name == "leaf" -%}<svg {{ common | safe }}><path d="M11 20A7 7 0 0 1 4 13V5h8a7 7 0 0 1 7 7v4"/><path d="M4 5c8 4 12 8 15 15"/></svg>
{%- elif name == "shield" -%}<svg {{ common | safe }}><path d="M12 22s8-4 8-12V4l-8-2-8 2v6c0 8 8 12 8 12z"/><path d="M9 12l2 2 4-4"/></svg>
{%- elif name == "whatsapp" -%}<svg {{ common | safe }}><path d="M3 20l1.3-4a8 8 0 1 1 3 3L3 20z"/><path d="M8.5 10.5c.5 2 2 3.5 4 4l1.3-1.3 2.2.6-.6 2.2a7 7 0 0 1-8.4-8.4l2.2-.6.6 2.2-1.3 1.3z"/></svg>
{%- elif name == "mail" -%}<svg {{ common | safe }}><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
{%- elif name == "instagram" -%}<svg {{ common | safe }}><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
{%- elif name == "menu" -%}<svg {{ common | safe }}><path d="M4 6h16M4 12h16M4 18h16"/></svg>
{%- endif -%}
{%- endmacro -%}

{%- macro logoMark(size=44) -%}
<img src="/images/logo.png" alt="Uma Sacola" width="{{ size }}" height="{{ size }}" />
{%- endmacro -%}

{%- macro brand(dark=false, withTagline=true) -%}
<div class="brand">
  <div class="brand-mark">{{ logoMark(48) }}</div>
  <div class="brand-name {% if dark %}dark{% endif %}">
    {% if withTagline %}<span class="tl">Sacolas personalizadas</span>{% endif %}
    <img src="/images/logo-text.svg" alt="Uma Sacola" class="brand-wordmark" />
  </div>
</div>
{%- endmacro -%}
